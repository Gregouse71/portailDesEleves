#/home/rezal/.config/systemd/user/site-backend.service

[Unit]
Description="Serveur pour le backend du site."
After=network.target

[Service]
Type=notify
WorkingDirectory=/home/rezal/site/backend
ExecStart=/home/rezal/miniconda3/envs/portail/bin/gunicorn --worker-class geventwebsocket.gunicorn.workers.GeventWebSocketWorker -b 127.0.0.1:5000 -w 5 run:app
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=5
PrivateTmp=true
Restart=on-failure

[Install]
WantedBy=default.target